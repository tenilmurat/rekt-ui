# Copy to .env.local for development. All of these are baked into the browser
# bundle at build time, so in Coolify set them as build variables.
# With nothing set the site still runs: browsing works and sign-in says it's off.

# This site's public address; install commands point at its registry (<site>/r/<id>.json).
# Leave empty to use the address the page is opened on.
NEXT_PUBLIC_SITE_URL=

# Set to 1 once the `rektui` package is on npm: Install then leads with `npx rektui@latest add`.
NEXT_PUBLIC_REKTUI_CLI=

# The API (apps/api), e.g. http://localhost:4000 or https://api.<domain>
NEXT_PUBLIC_API_URL=

# Supabase (Project settings → API keys): sign-in only. Never the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paddle: overlay checkout. "sandbox" until the live account is approved.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_LIFETIME=

# Optional: mount under a path instead of the domain root, e.g. /components
NEXT_PUBLIC_BASE_PATH=
