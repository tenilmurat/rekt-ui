# Copy to .env for local development; in Coolify set these as environment variables.
PORT=4000
# Frontend origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3500

# ── Supabase (Project settings → API keys) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Bypasses row-level security. Server only — never put it in the frontend.
SUPABASE_SECRET_KEY=

# ── Paddle ──────────────────────────────────────────────────────────────────
# "sandbox" until the live account is approved, then "production".
PADDLE_ENV=sandbox
# Developer tools → Authentication → API key.
PADDLE_API_KEY=
# Developer tools → Notifications → the destination's secret key.
# Destination URL: https://<api domain>/billing/webhook
PADDLE_WEBHOOK_SECRET=
# Catalog → the one-time Lifetime price (the yearly Pro price is only needed by the frontend).
PADDLE_PRICE_LIFETIME=
